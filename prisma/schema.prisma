generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PerfilUsuario {
  ADMIN
  COLABORADOR
}

enum StatusOS {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum AcaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  ATRIBUIR
  REMOVER_ATRIBUICAO
  ALTERAR_STATUS
  ATIVAR
  DESATIVAR
  LOGIN
  LOGOUT
  FALHA_LOGIN
  EXPORTAR
}

model User {
  id      String        @id @default(cuid())
  nome    String
  email   String        @unique
  senha   String
  fotoUrl String?
  perfil  PerfilUsuario @default(COLABORADOR)
  ativo   Boolean       @default(true)

  ordensCriadas          OrdemServico[]          @relation("CriadorOS")
  ordensResponsavel      ResponsavelOS[]
  preventivasResponsavel ResponsavelPreventiva[]
  logsAuditoria          LogAuditoria[]          @relation("UsuarioAuditoria")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setor {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  ordens      OrdemServico[]
  preventivas OrdemPreventiva[]
  maquinas    Maquina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Maquina {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  ordens      OrdemServico[]
  preventivas OrdemPreventiva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, setorId])
  @@index([setorId])
}

model OrdemServico {
  id         String       @id @default(cuid())
  numero     Int          @unique
  titulo     String
  descricao  String
  status     StatusOS     @default(NAO_INICIADA)
  prioridade PrioridadeOS @default(MEDIA)

  dataInicio    DateTime?
  dataPrevista  DateTime?
  dataConclusao DateTime?
  dataParada    DateTime?

  anotacoes     String?
  registroFinal String?

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id])

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)

  criadoPorId String?
  criadoPor   User?   @relation("CriadorOS", fields: [criadoPorId], references: [id])

  responsaveis ResponsavelOS[]
  fotos        FotoOS[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setorId])
  @@index([maquinaId])
  @@index([status])
  @@index([prioridade])
}

model ResponsavelOS {
  id String @id @default(cuid())

  osId String
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([osId, userId])
  @@index([userId])
}

model FotoOS {
  id       String  @id @default(cuid())
  url      String
  publicId String?

  osId String
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([osId])
}

model OrdemPreventiva {
  id String @id @default(cuid())

  titulo     String
  descricao  String
  prioridade PrioridadeOS @default(MEDIA)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id])

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)

  responsaveis ResponsavelPreventiva[]

  status String @default("PENDENTE")

  dataAgendada   DateTime
  diasAntesAviso Int      @default(1)

  notificado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([setorId])
  @@index([maquinaId])
  @@index([dataAgendada])
}

model ResponsavelPreventiva {
  id String @id @default(cuid())

  preventivaId String
  preventiva   OrdemPreventiva @relation(fields: [preventivaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([preventivaId, userId])
  @@index([preventivaId])
  @@index([userId])
}

model LogAuditoria {
  id String @id @default(cuid())

  acao       AcaoAuditoria
  entidade   String
  entidadeId String?

  descricao String

  dadosAnteriores Json?
  dadosNovos      Json?

  usuarioId String?
  usuario   User?   @relation("UsuarioAuditoria", fields: [usuarioId], references: [id], onDelete: SetNull)

  usuarioNome  String?
  usuarioEmail String?

  ip        String?
  userAgent String?
  rota      String?
  metodo    String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([createdAt])
}
