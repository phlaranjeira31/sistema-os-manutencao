generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PerfilUsuario {
  ADMIN
  COLABORADOR
}

enum StatusOS {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum TipoSetor {
  MANUTENCAO
  OPERACIONAL
  ADMINISTRATIVO
  OUTRO
}

enum AcaoAuditoria {
  CRIAR
  EDITAR
  EXCLUIR
  ATRIBUIR
  REMOVER_ATRIBUICAO
  ALTERAR_STATUS
  ATIVAR
  DESATIVAR
  LOGIN
  LOGOUT
  FALHA_LOGIN
  EXPORTAR
}

model Empresa {
  id    String  @id @default(cuid())
  nome  String  @unique
  sigla String  @unique
  ativo Boolean @default(true)

  logoUrl          String?
  cor              String?
  emailNotificacao String?

  usuariosOrigem      User[]                   @relation("EmpresaOrigemUser")
  usuariosAtendimento UserEmpresaAtendimento[]

  setores     Setor[]
  ordens      OrdemServico[]
  preventivas OrdemPreventiva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id      String        @id @default(cuid())
  nome    String
  email   String        @unique
  senha   String
  fotoUrl String?
  perfil  PerfilUsuario @default(COLABORADOR)
  ativo   Boolean       @default(true)

  empresaOrigemId String?
  empresaOrigem   Empresa? @relation("EmpresaOrigemUser", fields: [empresaOrigemId], references: [id], onDelete: SetNull)

  setorId String?
  setor   Setor?  @relation("SetorUser", fields: [setorId], references: [id], onDelete: SetNull)

  funcaoId String?
  funcao   Funcao? @relation("FuncaoUser", fields: [funcaoId], references: [id], onDelete: SetNull)

  empresasAtendimento UserEmpresaAtendimento[]

  ordensCriadas          OrdemServico[]          @relation("CriadorOS")
  ordensResponsavel      ResponsavelOS[]
  preventivasResponsavel ResponsavelPreventiva[]
  logsAuditoria          LogAuditoria[]          @relation("UsuarioAuditoria")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaOrigemId])
  @@index([setorId])
  @@index([funcaoId])
  @@index([perfil])
  @@index([ativo])
}

model UserEmpresaAtendimento {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, empresaId])
  @@index([userId])
  @@index([empresaId])
  @@index([ativo])
}

model Setor {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  tipo TipoSetor @default(OUTRO)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  usuarios User[]   @relation("SetorUser")
  funcoes  Funcao[]

  ordens      OrdemServico[]
  preventivas OrdemPreventiva[]
  maquinas    Maquina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([tipo])
  @@index([ativo])
}

model Funcao {
  id        String  @id @default(cuid())
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  usuarios User[] @relation("FuncaoUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, setorId])
  @@index([setorId])
  @@index([ativo])
}

model Maquina {
  id    String  @id @default(cuid())
  nome  String
  ativo Boolean @default(true)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  ordens      OrdemServico[]
  preventivas OrdemPreventiva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, setorId])
  @@index([setorId])
}

model OrdemServico {
  id         String       @id @default(cuid())
  numero     Int          @unique
  titulo     String
  descricao  String
  status     StatusOS     @default(NAO_INICIADA)
  prioridade PrioridadeOS @default(MEDIA)

  dataInicio    DateTime?
  dataPrevista  DateTime?
  dataConclusao DateTime?
  dataParada    DateTime?

  anotacoes     String?
  registroFinal String?

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id])

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)

  criadoPorId String?
  criadoPor   User?   @relation("CriadorOS", fields: [criadoPorId], references: [id])

  responsaveis ResponsavelOS[]
  fotos        FotoOS[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([setorId])
  @@index([maquinaId])
  @@index([status])
  @@index([prioridade])
}

model ResponsavelOS {
  id String @id @default(cuid())

  osId String
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([osId, userId])
  @@index([userId])
}

model FotoOS {
  id       String  @id @default(cuid())
  url      String
  publicId String?

  osId String
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([osId])
}

model OrdemPreventiva {
  id String @id @default(cuid())

  titulo     String
  descricao  String
  prioridade PrioridadeOS @default(MEDIA)

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id])

  maquinaId String?
  maquina   Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)

  responsaveis ResponsavelPreventiva[]

  status String @default("PENDENTE")

  dataAgendada   DateTime
  diasAntesAviso Int      @default(1)

  notificado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([setorId])
  @@index([maquinaId])
  @@index([dataAgendada])
}

model ResponsavelPreventiva {
  id String @id @default(cuid())

  preventivaId String
  preventiva   OrdemPreventiva @relation(fields: [preventivaId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([preventivaId, userId])
  @@index([preventivaId])
  @@index([userId])
}

model LogAuditoria {
  id String @id @default(cuid())

  acao       AcaoAuditoria
  entidade   String
  entidadeId String?

  descricao String

  dadosAnteriores Json?
  dadosNovos      Json?

  usuarioId String?
  usuario   User?   @relation("UsuarioAuditoria", fields: [usuarioId], references: [id], onDelete: SetNull)

  usuarioNome  String?
  usuarioEmail String?

  ip        String?
  userAgent String?
  rota      String?
  metodo    String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([createdAt])
}
